{
  "name": "rag-sourcebook-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "warm-model": "tsx scripts/warm-model.ts"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@huggingface/transformers": "^4.3.1",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@langchain/pgvector": "^0.1.0",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
