# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string (database must have the vector extension available)
DATABASE_URL=postgresql://localhost:5432/rag_sourcebook

# Allowed browser origin for CORS (the deployed client origin in production)
CLIENT_ORIGIN=http://localhost:5173

# Local sentence-embedding model (Transformers.js). Changing it requires a
# schema dimension update and full re-index.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
