# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string (database must have the vector extension available)
DATABASE_URL=postgresql://localhost:5432/rag_sourcebook

# Allowed browser origin for CORS (the deployed client origin in production)
CLIENT_ORIGIN=http://localhost:5173

# Local sentence-embedding model (Transformers.js). Changing it requires a
# schema dimension update and full re-index.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Chat generation. Any OpenAI-compatible endpoint works: the base URL, key, and
# model are configuration only, with no provider baked into the code. Unset
# values are reported as "not configured" (503) rather than failing a request.
# Free model IDs carry a ":free" suffix on OpenRouter; verify against the live
# catalog (https://openrouter.ai/api/v1/models) before pinning one. Reasoning
# models spend part of their output budget on hidden reasoning, so the chosen
# model's reasoning phase must fit the server's 800-token budget.
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Comma-separated hostnames accepted by the MCP endpoint (host-header
# validation). Leave unset locally; set to the deployed hostname in production.
# MCP_ALLOWED_HOSTS=api.example.com
